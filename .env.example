# Copy to backend/.env and add your own Twelve Data API key.
# Never prefix provider secrets with VITE_ or expose them to the browser.
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/quantara

# Generate a unique random value of at least 32 characters for server sessions.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Comma-separated exact browser origins allowed to use credentialed API requests.
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Set to 1 only when deployed behind a trusted reverse proxy.
TRUST_PROXY=0

# Market ticker refresh interval in milliseconds (90 seconds by default;
# four-symbol batches rotate through a 30-symbol watchlist in about 12 minutes)
TICKER_REFRESH_MS=90000

# Optional subset/reordering of the maintained backend/src/tickerWatchlist.js identities.
TICKER_SYMBOLS=AAPL,NVDA

